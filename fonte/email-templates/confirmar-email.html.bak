<!doctype html>
<html lang="pt-BR" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<!--[if !mso]><!--><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet"><!--<![endif]-->
<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->
<!--[if mso]>
<style>
  table, td, div, a, span { font-family:'Segoe UI', Helvetica, Arial, sans-serif !important; }
</style>
<![endif]-->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
  :root{ color-scheme: light dark; supported-color-schemes: light dark; }
  body{ margin:0; padding:0; -webkit-text-size-adjust:100%; }
  a{ text-decoration:none; }
  .btn:hover{ background-color:#116330 !important; }
  @media (max-width:600px){
    .container{ width:100% !important; }
    .px{ padding-left:24px !important; padding-right:24px !important; }
    .btn-table{ width:100% !important; }
    .btn{ display:block !important; width:100% !important; box-sizing:border-box; }
  }
  @media (prefers-color-scheme: dark){
    .bg-page{ background-color:#15181c !important; }
    .bg-card{ background-color:#1e2227 !important; }
    .bd-card{ border-color:#2c3138 !important; }
    .t-title{ color:#f1f3f5 !important; }
    .t-body{ color:#b8c0c9 !important; }
    .t-muted{ color:#8a94a0 !important; }
    .t-link{ color:#5cbf7d !important; }
    .bg-soft{ background-color:#262b31 !important; border-color:#343a42 !important; }
    .hairline{ border-color:#2c3138 !important; }
  }
  /* dark mode dos apps do Outlook (usam data-ogsc/ogsb em vez de prefers-color-scheme) */
  [data-ogsb] .bg-page{ background-color:#15181c !important; }
  [data-ogsb] .bg-card{ background-color:#1e2227 !important; }
  [data-ogsb] .bg-soft{ background-color:#262b31 !important; border-color:#343a42 !important; }
  [data-ogsc] .t-title{ color:#f1f3f5 !important; }
  [data-ogsc] .t-body{ color:#b8c0c9 !important; }
  [data-ogsc] .t-muted{ color:#8a94a0 !important; }
  [data-ogsc] .t-link{ color:#5cbf7d !important; }
</style>
</head>
<body class="bg-page" style="margin:0;padding:0;background-color:#f4f5f7;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">

<!-- texto de pré-visualização (aparece na lista do Gmail, invisível no corpo) -->
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">Confirme seu e-mail para ativar seu acesso ao Painel Santa Rita.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="bg-page" style="background-color:#f4f5f7;">
<tr><td align="center" style="padding:40px 16px 16px;">

  <!-- ===== CARTÃO PRINCIPAL ===== -->
  <table role="presentation" width="560" cellpadding="0" cellspacing="0" class="container bg-card bd-card" style="width:560px;max-width:560px;background-color:#ffffff;border:1px solid #e7eaee;border-radius:16px;overflow:hidden;">

    <!-- linha verde institucional, discreta -->
    <tr><td style="height:3px;line-height:3px;font-size:3px;background-color:#157a35;">&nbsp;</td></tr>

    <!-- ===== CABEÇALHO ===== -->
    <tr><td class="px" style="padding:28px 40px 22px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td valign="middle" style="line-height:0;">
          <img src="https://vitakero.github.io/painel-de-gestao-santa-rita/assets/simbolo-carrinho.png" alt="Painel Santa Rita" width="52" style="display:block;width:52px;height:auto;border:0;color:#157a35;font-family:'Inter',Arial,sans-serif;font-size:15px;font-weight:700;line-height:1.3;">
        </td>
        <td valign="middle" align="right">
          <div class="t-title" style="font-size:13px;font-weight:600;color:#111827;line-height:1.35;">Painel Santa Rita</div>
          <div class="t-muted" style="font-size:12px;color:#64748b;line-height:1.35;">Gestão interna da loja</div>
        </td>
      </tr>
      </table>
    </td></tr>

    <!-- fio divisor -->
    <tr><td class="px" style="padding:0 40px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td class="hairline" style="border-top:1px solid #edf0f3;height:1px;line-height:1px;font-size:1px;">&nbsp;</td></tr></table></td></tr>

    <!-- ===== CONTEÚDO ===== -->
    <tr><td class="px" style="padding:34px 40px 8px;">

      <h1 class="t-title" style="font-size:22px;font-weight:700;color:#0f172a;letter-spacing:-0.2px;line-height:1.3;margin:0 0 8px;">Confirme seu e-mail</h1>

      <div class="t-body" style="font-size:15px;color:#475569;line-height:1.65;">
        Você criou uma conta no Painel Santa Rita. Clique no botão abaixo para confirmar seu e-mail e ativar seu acesso. Depois, é só o administrador liberar as páginas pra você.
      </div>
    </td></tr>

    <!-- ===== BOTÃO ===== -->
    <tr><td class="px" align="center" style="padding:26px 40px 6px;">
      <table role="presentation" cellpadding="0" cellspacing="0" align="center" class="btn-table" style="margin:0 auto;"><tr>
        <td align="center" bgcolor="#157a35" style="background-color:#157a35;border-radius:12px;mso-padding-alt:16px 40px;">
          <a href="{{ .ConfirmationURL }}" target="_blank" class="btn"
             style="display:inline-block;background-color:#157a35;color:#ffffff;font-family:'Inter',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;line-height:18px;padding:16px 40px;border-radius:12px;">
            Confirmar e-mail
          </a>
        </td>
      </tr></table>
    </td></tr>

    <!-- ===== CARD DE SEGURANÇA ===== -->
    <tr><td class="px" style="padding:26px 40px 34px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="bg-soft" style="background-color:#f8fafc;border:1px solid #eceff3;border-radius:12px;">
      <tr><td style="padding:16px 18px;">
        <div class="t-title" style="font-size:13px;font-weight:600;color:#0f172a;margin-bottom:10px;">Segurança</div>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:13px;color:#64748b;line-height:1.7;">
          <tr>
            <td width="18" valign="top" style="color:#157a35;font-size:13px;line-height:1.7;">&bull;</td>
            <td class="t-body" style="font-size:13px;color:#64748b;line-height:1.7;">Este link expira em <strong style="font-weight:600;">1 hora</strong></td>
          </tr>
          <tr>
            <td width="18" valign="top" style="color:#157a35;font-size:13px;line-height:1.7;">&bull;</td>
            <td class="t-body" style="font-size:13px;color:#64748b;line-height:1.7;">Só pode ser usado <strong style="font-weight:600;">uma vez</strong></td>
          </tr>
          <tr>
            <td width="18" valign="top" style="color:#157a35;font-size:13px;line-height:1.7;">&bull;</td>
            <td class="t-body" style="font-size:13px;color:#64748b;line-height:1.7;">Foi gerado ao criar a sua conta</td>
          </tr>
        </table>
        <div class="t-body" style="font-size:13px;color:#64748b;line-height:1.7;margin-top:10px;">Se você não criou esta conta, ignore este e-mail — nada será feito.</div>
      </td></tr>
      </table>
    </td></tr>

  </table>

  <!-- ===== RODAPÉ ===== -->
  <table role="presentation" width="560" cellpadding="0" cellspacing="0" class="container" style="width:560px;max-width:560px;">
  <tr><td align="center" style="padding:26px 24px 8px;">
    <div class="t-muted" style="font-size:13px;font-weight:600;color:#5b6672;line-height:1.6;">Supermercado Santa Rita</div>
    <div class="t-muted" style="font-size:12px;color:#5b6672;line-height:1.7;">
      Painel Santa Rita &nbsp;&middot;&nbsp; Caicó &bull; RN<br>
      <a href="https://painel-de-gestao-santa-rita.vercel.app" target="_blank" class="t-muted" style="color:#5b6672;text-decoration:underline;">Acessar o painel</a>
      &nbsp;&middot;&nbsp;
      <a href="mailto:diretoria@supermercadosantarita.com.br" class="t-muted" style="color:#5b6672;text-decoration:underline;">diretoria@supermercadosantarita.com.br</a>
    </div>
    <div class="t-muted" style="font-size:12px;color:#5b6672;line-height:1.6;margin-top:12px;">Este é um e-mail automático. Não responda esta mensagem.</div>
  </td></tr>
  </table>

</td></tr>
</table>
</body>
</html>
